# Copy to .env and fill in values before running docker compose

DB_USER=gotiga
DB_PASSWORD=gotiga_password
DB_NAME=gotiga

ADMIN_API_KEY=change_me_in_prod

PUBLIC_URL=http://localhost
FRONTEND_PORT=80

RUST_LOG=info,sqlx=warn

# ── Frontend web (prerender) build — used by `npm run build:web` ──
# Absolute origin of the API backend, read during prerender (Node has no localStorage).
# No trailing slash. Example: https://api.gotiga.com
VITE_API_BASE=
# Set automatically by `npm run build:web`; leave unset for the Tauri/default SPA build.
# VITE_BUILD_TARGET=web
