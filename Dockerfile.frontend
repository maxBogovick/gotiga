# ── Build stage ────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .

# VITE_* values are baked in at build time. Vite exposes process.env vars that
# start with VITE_, so passing them as ENV makes `vite build` pick them up.
ARG VITE_BRAND_NAME=""
ARG VITE_API_BASE=""
ARG VITE_BUILD_TARGET=""
ENV VITE_BRAND_NAME=${VITE_BRAND_NAME}
ENV VITE_API_BASE=${VITE_API_BASE}
ENV VITE_BUILD_TARGET=${VITE_BUILD_TARGET}

RUN npm run build

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Included by default.conf at server level and again inside every location that sets
# its own add_header (nginx replaces rather than merges inherited add_headers).
COPY nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
