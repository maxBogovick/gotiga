# ── Build stage ────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .

# VITE_* values are baked in at build time. Vite exposes process.env vars that
# start with VITE_, so passing them as ENV makes `vite build` pick them up.
#
# VITE_BUILD_TARGET defaults to `web` — NOT to the empty SPA target it used to.
# This image is only ever the public web deploy: its output is what the nginx stage
# below serves, and Tauri never builds through it. But the target was an opt-in, so a
# caller that forgot `--build-arg VITE_BUILD_TARGET=web` (build-and-push.sh passed no
# build args at all) got a plain SPA shell — no prerendered HTML for crawlers or share
# previews, no service worker, and a hero <img> the browser cannot even discover until
# the JS bundle has run and an API round-trip has come back. The whole prerender
# machinery in +page.ts was dead in production. Defaulting it here means the image
# cannot be built wrong by omission; the knob still exists for anyone who wants the
# SPA on purpose (VITE_BUILD_TARGET="").
#
# Prerendering runs the load functions in Node, so it needs an absolute origin to read
# the catalogue from — that is VITE_API_BASE, and it must be reachable FROM THE BUILD
# (a container: not localhost). It is used at build time only; the browser always talks
# to the same-origin /api proxy. If it is missing, webApiBase() in src/lib/api.ts fails
# the build with an explicit message rather than an undici URL-parse stack trace.
ARG VITE_BRAND_NAME=""
ARG VITE_API_BASE="https://ritunia.com"
ARG VITE_BUILD_TARGET="web"
ENV VITE_BRAND_NAME=${VITE_BRAND_NAME}
ENV VITE_API_BASE=${VITE_API_BASE}
ENV VITE_BUILD_TARGET=${VITE_BUILD_TARGET}

# Prerender (+page.ts entries/load) fetches the live catalogue at build time, so the
# build output depends on REMOTE API state that Docker's layer cache cannot see. With a
# stable source + build-args, Docker happily reuses a stale `npm run build` layer even
# after new works/slugs appear in the DB — shipping an image with missing or outdated
# prerendered pages (this bit us: a slug rollout produced a sitemap of slug URLs while
# the image still only had UUID pages). CACHEBUST is referenced by the build RUN so a
# fresh value (build-frontend.sh passes `date +%s`) always invalidates JUST this step;
# `npm ci` and `COPY . .` above stay cached, so the rebuild is still fast.
ARG CACHEBUST=0
# `npm run build` (not build:web) so VITE_BUILD_TARGET keeps coming from the ENV
# above — a build:web-style hardcoded prefix would clobber the VITE_BUILD_TARGET=""
# escape hatch documented above. The markdown-twin generator (scripts/
# generate-markdown.mjs) only makes sense when there's prerendered HTML to convert,
# so it's gated on the same variable rather than folded into a second npm script
# that Dockerfile would then have to choose between.
RUN echo "cache-bust: ${CACHEBUST}" && npm run build && \
    if [ "$VITE_BUILD_TARGET" = "web" ]; then node scripts/generate-markdown.mjs build; fi

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Included by default.conf at server level and again inside every location that sets
# its own add_header (nginx replaces rather than merges inherited add_headers).
COPY nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
