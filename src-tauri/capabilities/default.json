{
   "$schema": "../gen/schemas/desktop-schema.json",
   "identifier": "default",
   "description": "Capability for the main window",
   "windows": ["main"],
   "permissions": [
      "core:default",
      "fs:default",
      "fs:allow-app-write-recursive",
      "fs:allow-app-read-recursive",
      "fs:allow-resource-read-recursive",
      "shell:allow-open",
      "dialog:default",
      "dialog:allow-open",
      "dialog:allow-save"
   ]
}